---
import '@om/ui/tokens.css'
import '../styles/notebooks.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { names, om } from '../lib/nb'
import { siteHosts } from '@om/content'
import SiteLinks from '@om/ui/SiteLinks.astro'
interface Props { title?: string; description?: string; current?: string }
const { title, description, current } = Astro.props
const n = names()
const o = om()
---
<!doctype html>
<html lang="en" data-site="notebooks">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} — ${n.title}` : n.title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Header current={current} />
    <slot />
    <Footer />
    <SiteLinks site="notebooks" hosts={siteHosts(o)} />
  </body>
</html>
