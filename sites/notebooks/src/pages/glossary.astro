---
import Base from '../layouts/Base.astro'
import { concepts, md, names, notebooksUsing, om } from '../lib/nb'
const o = om()
const all = concepts(o)
---
<Base title="Glossary" current="glossary">
  <section class="hero hero--short">
    <div class="eyebrow mono">{names(o).hub.toUpperCase()}</div>
    <h1>Glossary</h1>
  </section>
  <main class="glossary glossary--page">
    <h2 class="glossary-title">Glossary of key terms</h2>
    <dl class="glossary-list glossary-list--single">
      {all.map((c) => {
        const related = c.data.related.map((s) => o.bySlug.get(s)).filter((x) => x !== undefined)
        const used = notebooksUsing(c, o)
        return (
          <div class="glossary-item" id={c.slug}>
            <dt>
              {c.data.title}
              {c.data.aliases.length > 0 && <span class="aliases">{c.data.aliases.join(' · ')}</span>}
            </dt>
            <dd>
              <div set:html={md(c.body, o)} />
              {related.length > 0 && (
                <p class="meta"><span>Related</span>{related.map((r, i) => <>{i > 0 && ', '}<a href={`#${r.slug}`}>{r.data.title}</a></>)}</p>
              )}
              {used.length > 0 && (
                <p class="meta"><span>In</span>{used.map((n, i) => <>{i > 0 && ', '}<a href={`/${n.slug}`}>{n.data.title}</a></>)}</p>
              )}
            </dd>
          </div>
        )
      })}
    </dl>
  </main>
</Base>
