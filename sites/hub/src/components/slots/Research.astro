---
import SectionB from '../SectionB.astro'
import { href, notebookImage, notebooks, om } from '../../lib/hub'
interface Props { heading: string; intro?: string }
const { heading, intro } = Astro.props
const o = om()
const { frameworks, working } = notebooks(o)
---
<SectionB heading={heading} intro={intro} id="research">
  {(frameworks.length > 0 || working.length > 0) && <h2 class="h sb-sub">Notebooks</h2>}
  <div class="rgrid">
    {[...frameworks, ...working].map((n) => {
      const img = notebookImage(n, o)
      return (
        <div class="rgrid-cell">
          <a class="bcard ncard" href={href(n, o)}>
            {img && (
              <div class="ncard-img"><img src={img} alt="" loading="lazy" /></div>
            )}
            {n.data.framework && <span class="badge badge--strong">Framework</span>}
            <h2 class="h">{n.data.title}</h2>
            <p>{n.data.summary}</p>
          </a>
        </div>
      )
    })}
  </div>
</SectionB>
