---
import SectionB from '../SectionB.astro'
import { href, notebooks, om } from '../../lib/hub'
interface Props { heading: string; intro?: string }
const { heading, intro } = Astro.props
const o = om()
const { frameworks, working } = notebooks(o)
---
<SectionB heading={heading} intro={intro} id="research">
  {frameworks.length > 0 && (
    <>
      <h2 class="h sb-sub">Frameworks</h2>
      <div class="rgrid">
        {frameworks.map((n) => (
          <div class="rgrid-cell">
            <div class="bcard">
              <h2 class="h"><a href={href(n, o)}>{n.data.title}</a></h2>
              <p>{n.data.summary}</p>
            </div>
          </div>
        ))}
      </div>
    </>
  )}
  {working.length > 0 && (
    <>
      <h2 class:list={['h', 'sb-sub', { 'sb-sub--next': frameworks.length > 0 }]}>Notebooks</h2>
      <div class="bstack">
        {working.map((n) => (
          <div class="bcard">
            <h2 class="h"><a href={href(n, o)}>{n.data.title}</a></h2>
            <p>{n.data.summary}</p>
          </div>
        ))}
      </div>
    </>
  )}
</SectionB>
