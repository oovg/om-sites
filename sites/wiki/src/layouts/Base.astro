---
import '@om/ui/tokens.css'
import '../styles/wiki.css'
import Explorer from '../components/Explorer.astro'
import { names, om } from '../lib/wiki'
import { siteHosts } from '@om/content'
import SiteLinks from '@om/ui/SiteLinks.astro'
interface Props { title?: string; description?: string; current?: string; right?: boolean }
const { title, description, current, right = true } = Astro.props
const o = om()
const n = names(o)
const s = o.site?.data
---
<!doctype html>
<html lang="en" data-site="wiki">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${n.wiki}` : n.wiki}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <!-- Typekit kit shared with the hub (polymath-display, adobe-caslon-pro): see DECISIONS.md -->
    <link rel="stylesheet" href="https://use.typekit.net/ulo1dho.css" />
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <script is:inline>
      // Apply the reader's saved theme and reader mode before first paint.
      try {
        const t = localStorage.getItem('om-wiki-theme'); if (t) document.documentElement.dataset.theme = t
        const r = localStorage.getItem('om-wiki-reader'); if (r) document.documentElement.dataset.reader = r
      } catch {}
    </script>
  </head>
  <body>
    <header class="w-hdr">
      <p class="w-title h"><a href="/" class="ulink">{n.wiki}</a></p>
      <div class="w-tools">
        <div class="w-search" id="search"></div>
        <button type="button" class="w-btn" data-theme-toggle aria-label="Light or dark mode" title="Light or dark mode">
          <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
          <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
        </button>
        <button type="button" class="w-btn" data-reader-toggle aria-label="Reader mode" title="Reader mode">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5.5c3-1 6-1 9 1 3-2 6-2 9-1v13c-3-1-6-1-9 1-3-2-6-2-9-1z" /><path d="M12 6.5v13" /></svg>
        </button>
      </div>
    </header>
    <div class="w-grid">
      <aside class="w-side w-left" aria-label="Explorer"><Explorer current={current} /></aside>
      <main class="w-main" data-pagefind-body><slot /></main>
      <aside class="w-side w-right" aria-label="On this page">{right && <slot name="right" />}</aside>
    </div>
    <footer class="w-ftr">
      <span>{[s?.licence, n.hub].filter(Boolean).join(' | ')}</span>
      <span><a href={n.hubUrl} class="ulink">{n.hub}</a>{s?.tagline && ` · ${s.tagline}`}</span>
    </footer>
    <script is:inline>
      // Light/dark and reader-mode toggles, remembered in localStorage.
      const root = document.documentElement
      const dark = () => root.dataset.theme ? root.dataset.theme === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches
      document.querySelector('[data-theme-toggle]').addEventListener('click', () => {
        root.dataset.theme = dark() ? 'light' : 'dark'
        try { localStorage.setItem('om-wiki-theme', root.dataset.theme) } catch {}
      })
      document.querySelector('[data-reader-toggle]').addEventListener('click', () => {
        root.dataset.reader = root.dataset.reader === 'on' ? 'off' : 'on'
        try { localStorage.setItem('om-wiki-reader', root.dataset.reader) } catch {}
      })
      // Pagefind search (built after the site; absent in dev).
      const s = document.createElement('script')
      s.src = '/pagefind/pagefind-ui.js'
      s.onload = () => new PagefindUI({ element: '#search', showImages: false, resetStyles: false })
      s.onerror = () => { document.getElementById('search').innerHTML = '<span class="w-search-off">Search is built with the site</span>' }
      document.head.appendChild(s)
    </script>
    <SiteLinks site="wiki" hosts={siteHosts(o)} />
  </body>
</html>
