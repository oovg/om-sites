{
  "name": "om-sites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsx packages/content/check.ts",
    "media": "tsx scripts/media.ts",
    "build": "pnpm check && pnpm -r --filter \"./sites/*\" --if-present build",
    "dev": "pnpm -r --parallel --filter \"./sites/*\" --if-present dev",
    "preview": "pnpm -r --parallel --filter \"./sites/*\" --if-present preview",
    "check:fixture": "OUTER_MIND=$PWD/fixtures/outer-mind OM_MEDIA_FILES=$PWD/fixtures/media-files pnpm check",
    "build:fixture": "OUTER_MIND=$PWD/fixtures/outer-mind OM_MEDIA_FILES=$PWD/fixtures/media-files pnpm build",
    "dev:fixture": "OUTER_MIND=$PWD/fixtures/outer-mind OM_MEDIA_FILES=$PWD/fixtures/media-files pnpm dev",
    "media:fixture": "OUTER_MIND=$PWD/fixtures/outer-mind OM_MEDIA_FILES=$PWD/fixtures/media-files pnpm media"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "1.54.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
